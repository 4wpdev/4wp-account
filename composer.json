{
	"name": "4wpdev/4wp-account",
	"description": "User account hub for WordPress — auth providers, account pages, and navigation blocks",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "4wp.dev",
			"email": "4wp.dev@gmail.com"
		}
	],
	"require": {
		"php": ">=8.0",
		"composer/installers": "^2.0",
		"league/oauth2-google": "^4.0",
		"league/oauth2-facebook": "^2.0",
		"guzzlehttp/guzzle": "^7.0"
	},
	"require-dev": {
		"4wpdev/4wp-dev-toolkit": "@dev",
		"brain/monkey": "^2.6",
		"mockery/mockery": "^1.6"
	},
	"repositories": [
		{
			"type": "path",
			"url": "../4wp-dev-toolkit",
			"options": {
				"symlink": true
			}
		}
	],
	"autoload": {
		"psr-4": {
			"ForWP\\Account\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ForWP\\Account\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit"
	}
}
